# ============================================================================
# Bazarmio Web - Environment Variables Template
# ============================================================================
# Copy this file to .env.local (dev) or set these in your hosting platform
# Never commit .env.local or .env.production.local to version control

# ============================================================================
# API
# ============================================================================
# Internal URL the Next.js server uses to call the Bazarmio API
# This is SERVER-SIDE ONLY — never exposed to the browser
# Dev:     http://localhost:3001
# Staging: https://bazarmioapi-staging.up.railway.app
# Prod:    https://bazarmioapi-production.up.railway.app
BAZARMIO_API_URL=http://localhost:3001

# ============================================================================
# SITE URL (used for absolute URL generation — sitemap, OG tags, etc.)
# ============================================================================
# Dev:  http://localhost:3000
# Prod: https://bazarmio.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
